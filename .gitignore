# ============================================================
# RLPlayer .gitignore
# 原则：只提交【源码 + 文档 + 资源】；产物/隐私/密钥/第三方专有软件一律不进仓库
# ============================================================

# ---------- 1. 密钥（最重要：泄露即等于把 key 公开）----------
rlplayer-llm.conf
**/rlplayer-llm.conf
*.key
*.pem
.env
# 本地运行配置（含曲库路径 / 设备名，属于本机状态）
rlplayer-settings.conf
rlplayer-library.conf
rta-*.conf

# ---------- 2. 构建产物 ----------
/build/
/build-mac/
/build-*/
# 测试素材目录：tests/test_pipeline.cpp 在 cwd 下建 testdata/ 写 WAV。
# ctest 的 cwd 是 build-mac/（已被忽略），但从仓库根手动跑测试时会落在仓库根 ⟹ 这里兜住。
/testdata/
/buildwebview2/
/dist/
/out/
*.obj
*.o
*.lib
*.exp
*.pdb
*.ilk
# macOS 动态库构建产物（Apple Metal GPU 后端）
#   librtagpu.dylib 由 tools/build_gpu_metal_mac.sh 从 src/gpu/gpu_metal.mm 现场构建，
#   不进版本库（二进制不进仓库）。正式发布包由出包脚本内置它。
*.dylib
*.log
*.log.*
CMakeCache.txt
CMakeFiles/
.ninja_deps
.ninja_log
build.ninja
compile_commands.json

# ---------- 3. 用户数据 / 隐私 ----------
/MUSIC/
/rlplayer-meta/
/rta-index.tsv
/rlplayer-index.tsv
/profiles/
/反馈和开发/
/dumps/

# ---------- 4. 第三方【专有软件】，不进仓库（版权/许可原因）----------
/Tool/
/research/
/notes/
/debug/
/STATUS.md
/HANDOVER.md
/PLAN.md
/PLATFORM.md
/P1-调查.md
/验收说明.md
/ROADMAP.md
/docs/*.md
!/docs/GPU精度实测.md
!/docs/GPU卷积与升频效率细查.md
/docs/update/
/tools/libs_scan.py
/tools/manual_*.py
/tools/pdf_extract.py
/tools/README-template.txt

# ---------- 5. 编辑器 / 工具缓存 ----------
/.zcode/
/.vs/
/.vscode/
*.user
*.suo
docs/shots-ui03/
# macOS 产物目录（RLPlayer.app 为 make_app_mac.sh 生成物）
dist-mac/
.DS_Store

# 开发流程/代理指令（2026-10-27 用户要求：从公开仓库移除，仅保留本地副本）
AGENTS.md

# 本机临时索引快照（文件名可能带反斜杠字符，历史上误入库过一次）
*rlplayer-index.tsv*

# 品牌设计候选图（本地素材，不入库；2026-10-28）
/docs/brand/

# 本地代码备份不入库
*.bak
